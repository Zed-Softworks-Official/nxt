{
    "name": "nxt",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "deploy:discord": "turbo run deploy:discord",
        "dev": "turbo run dev",
        "check:write": "turbo run check:write",
        "check-types": "turbo run check-types",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "validate": "turbo run typecheck test",
        "ci": "turbo run typecheck test build",
        "ui": "pnpm --filter @nxt/nextjs run ui",
        "prepare": "husky"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.8",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "turbo": "^2.11.4",
        "typescript": "5.9.2"
    },
    "packageManager": "pnpm@12.18.0",
    "engines": {
        "node": "26.x"
    },
    "dependencies": {
        "dotenv-cli": "^11.0.0"
    }
}
