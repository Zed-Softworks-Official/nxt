# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" at the repo root and populate it with your secrets. Every app loads it
# via its `with-env` script (`dotenv -e ../../.env`).

# When adding additional environment variables, update the schema in the
# consuming app's `src/env.ts` accordingly.

# Convex
NEXT_PUBLIC_CONVEX_URL=""
# Server-only Convex deploy key. The dashboard and Discord bot use it as admin
# auth to call internal mutations.
CONVEX_DEPLOY_KEY=""

# Dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_DISCORD_CLIENT_ID=""
NEXT_PUBLIC_DISCORD_REDIRECT_URI=""
# Twitch linking: the Nxt Twitch app's client ID (same as TWITCH_CLIENT_ID) and
# the Convex HTTP route Twitch redirects to, https://<deployment>.convex.site/twitch.
# Register that URL as an OAuth redirect URL on the Twitch app.
NEXT_PUBLIC_TWITCH_CLIENT_ID=""
NEXT_PUBLIC_TWITCH_REDIRECT_URI=""

# Discord Bot
# Optional: defaults to NEXT_PUBLIC_CONVEX_URL.
# CONVEX_URL=""
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
# Optional: register slash commands to a single guild during development.
# GUILD_ID=""

# Twitch Bot
# The Nxt Twitch app's credentials. The client secret also mints the app access
# token used for EventSub and chat replies.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
# User ID of the Nxt bot account. It must have authorized the app once with
# user:read:chat, user:write:chat and user:bot.
TWITCH_BOT_USER_ID=""
# Public hostname of the HTTPS reverse proxy in front of the EventSub listener.
# Webhooks arrive at https://<host>/event/<subscription id>.
TWITCH_EVENTSUB_HOSTNAME=""
# Random 10–100 character secret Twitch signs EventSub webhooks with.
TWITCH_EVENTSUB_SECRET=""
# Optional: port the listener binds (default 8080).
# TWITCH_EVENTSUB_PORT=""

# Convex deployment (set with `npx convex env set`, not read from this file)
CLERK_WEBHOOK_SECRET=""
CLERK_ISSUER_URL=""
# Optional: the dashboard's origin, where link callbacks send the owner back
# to. Defaults to http://localhost:3000.
# DASHBOARD_URL=""
# Discord linking exchanges the bot-install `code` for the guild. It needs
# DISCORD_CLIENT_ID set on the deployment (same value as the bot's above),
# plus the app's client secret and the `/discord` HTTP route URL, which must
# equal NEXT_PUBLIC_DISCORD_REDIRECT_URI.
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI=""
# HMAC key (16+ chars) for signing platform link `state` tokens.
# Generate with: openssl rand -base64 32
LINK_STATE_SECRET=""
# Twitch linking also needs TWITCH_CLIENT_ID, TWITCH_CLIENT_SECRET,
# TWITCH_BOT_USER_ID, TWITCH_EVENTSUB_HOSTNAME and TWITCH_EVENTSUB_SECRET set
# on the deployment, with the same values as the Twitch bot above, plus:
# The `/twitch` HTTP route URL; must equal NEXT_PUBLIC_TWITCH_REDIRECT_URI.
TWITCH_REDIRECT_URI=""
