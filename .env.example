# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" at the repo root and populate it with your secrets. Every app loads it
# via its `with-env` script (`dotenv -e ../../.env`).

# When adding additional environment variables, update the schema in the
# consuming app's `src/env.ts` accordingly.

# Convex
NEXT_PUBLIC_CONVEX_URL=""
# Server-only Convex deploy key. The dashboard and Discord bot use it as admin
# auth to call internal mutations.
CONVEX_DEPLOY_KEY=""

# Dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_DISCORD_CLIENT_ID=""
NEXT_PUBLIC_DISCORD_REDIRECT_URI=""

# Discord Bot
# Optional: defaults to NEXT_PUBLIC_CONVEX_URL.
# CONVEX_URL=""
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
# Optional: register slash commands to a single guild during development.
# GUILD_ID=""
