{
    "$schema": "https://v2-11-4.turborepo.dev/schema.json",
    "extends": ["//"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env"],
            "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
